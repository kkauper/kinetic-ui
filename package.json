{
  "name": "kinetic-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev --workspace apps/demo --if-present",
    "build": "npm run build --workspace apps/demo --if-present",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
