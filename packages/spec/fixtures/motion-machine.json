{
  "$comment": "Pure hysteresis reducer. Start from initialMachine(0): state still, enteredAt 0, no pending. Apply each step in order (stepMachine({now: t, walking})). When a step has expect, compare state, pending, and enteredAt / pendingSince if present. config overrides the defaults (enterMovingAfterMs 3000, exitMovingAfterMs 10000); cases that test a specific delay set it explicitly so they do not depend on the default, and one case checks the defaults themselves. Leaky accumulator: progressMs grows by the time since the previous step while the input argues for the pending change and shrinks by 2 x that time (decay ratio 2) while it does not; the lean is dropped at 0 and the change commits when progressMs reaches the delay. pendingSince is when the lean started from 0; progressMs is also checked where given. Times are in ms.",
  "version": 1,
  "cases": [
    {
      "name": "defaults: enters moving after 3 s, leaves after 10 s",
      "steps": [
        {"t": 0, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 2999, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 3000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 3000}},
        {"t": 4000, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 4000}},
        {"t": 13999, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 4000}},
        {"t": 14000, "walking": false, "expect": {"state": "still", "pending": null, "enteredAt": 14000}}
      ]
    },
    {
      "name": "enters moving only after 5 s of sustained walking",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 1000, "walking": true},
        {"t": 4000, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 5000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000}}
      ]
    },
    {
      "name": "one millisecond short of the threshold is still pending",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 4999, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 5000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000}}
      ]
    },
    {
      "name": "a 2 s walk does not enter moving",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 1000, "walking": true},
        {"t": 2000, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 3000, "walking": false, "expect": {"state": "still", "pending": null}},
        {"t": 20000, "walking": false, "expect": {"state": "still", "pending": null}}
      ]
    },
    {
      "name": "a brief interruption costs 2 x its duration of progress, it does not restart the clock",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 3000, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0, "progressMs": 3000}},
        {"t": 4000, "walking": false, "expect": {"state": "still", "pending": "moving", "pendingSince": 0, "progressMs": 1000}},
        {"t": 5000, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0, "progressMs": 2000}},
        {"t": 7999, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 8000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 8000, "progressMs": 0}}
      ]
    },
    {
      "name": "a long real stop still cancels the lean",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 3000, "walking": true, "expect": {"pending": "moving", "progressMs": 3000}},
        {"t": 4000, "walking": false, "expect": {"pending": "moving", "progressMs": 1000}},
        {"t": 5000, "walking": false, "expect": {"state": "still", "pending": null, "pendingSince": null, "progressMs": 0}},
        {"t": 6000, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 6000, "progressMs": 0}}
      ]
    },
    {
      "name": "exits moving only after 10 s of non-walking",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 5000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000}},
        {"t": 6000, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 6000}},
        {"t": 15000, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 6000}},
        {"t": 16000, "walking": false, "expect": {"state": "still", "pending": null, "enteredAt": 16000}}
      ]
    },
    {
      "name": "a 4 s traffic-light pause does not exit moving",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": true},
        {"t": 5000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000}},
        {"t": 6000, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 6000}},
        {"t": 9000, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 6000}},
        {"t": 10000, "walking": true, "expect": {"state": "moving", "pending": "still", "pendingSince": 6000, "progressMs": 1000}},
        {"t": 10500, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000, "progressMs": 0}},
        {"t": 20000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 5000}}
      ]
    },
    {
      "name": "never walking stays still with nothing pending",
      "config": {"enterMovingAfterMs": 5000},
      "steps": [
        {"t": 0, "walking": false, "expect": {"state": "still", "pending": null, "enteredAt": 0}},
        {"t": 30000, "walking": false, "expect": {"state": "still", "pending": null, "enteredAt": 0}}
      ]
    },
    {
      "name": "custom config: enter after 1 s, exit after 2 s",
      "config": {"enterMovingAfterMs": 1000, "exitMovingAfterMs": 2000},
      "steps": [
        {"t": 0, "walking": true, "expect": {"state": "still", "pending": "moving", "pendingSince": 0}},
        {"t": 1000, "walking": true, "expect": {"state": "moving", "pending": null, "enteredAt": 1000}},
        {"t": 1500, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 1500}},
        {"t": 3499, "walking": false, "expect": {"state": "moving", "pending": "still", "pendingSince": 1500}},
        {"t": 3500, "walking": false, "expect": {"state": "still", "pending": null, "enteredAt": 3500}}
      ]
    }
  ]
}
